# ==========================
# API
# ==========================
REACT_APP_API_URL=http://localhost:5000/api
//REACT_APP_API_URL=https://diamond-square-backend.onrender.com/api

# ==========================
# APP
# ==========================
REACT_APP_APP_NAME=Diamond Square
REACT_APP_APP_VERSION=2.0.0
REACT_APP_ENV=development

# ==========================
# FEATURES
# ==========================
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_EXPORT=true

# ==========================
# UPLOADS
# ==========================
REACT_APP_MAX_UPLOAD_SIZE=5242880
REACT_APP_ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
REACT_APP_ALLOWED_DOCUMENT_TYPES=pdf,doc,docx

# ==========================
# PAGINATION
# ==========================
REACT_APP_DEFAULT_PAGE_SIZE=10
REACT_APP_MAX_PAGE_SIZE=100

# ==========================
# REQUESTS
# ==========================
REACT_APP_REQUEST_TIMEOUT=30000

# ==========================
# DATE & TIME
# ==========================
REACT_APP_DATE_FORMAT=DD/MM/YYYY
REACT_APP_TIME_FORMAT=hh:mm A

# ==========================
# THEME
# ==========================
REACT_APP_DEFAULT_THEME=light
REACT_APP_PRIMARY_COLOR=emerald